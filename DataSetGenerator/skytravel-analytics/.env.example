# ============================================
# SKYTRAVEL NICARAGUA - CONEXIÓN SQL SERVER
# Copia este archivo como .env y ajusta tus datos
# ============================================

# Autenticación de Windows (recomendada en local)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ServicioCiudadanoDW
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED=yes

# Autenticación de SQL Server (opcional)
# DB_SERVER=localhost\SQLEXPRESS
# DB_NAME=ServicioCiudadanoDW
# DB_USER=sa
# DB_PASSWORD=TuPassword123!
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_TRUSTED=no
